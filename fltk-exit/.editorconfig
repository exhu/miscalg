root = true
# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset=utf-8
max_line_length = 80

[*.{c,cpp,hpp,hxx,cxx,h,d,pas,inc,pp,lpr}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4
