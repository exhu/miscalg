		"export PKG_CONFIG_PATH=\"$HOME/.local/lib/pkgconfig:$PKG_CONFIG_PATH\" && if [ ! -d \"_build\" ]; then meson setup _build .; fi && meson compile -C _build sdlffcd_sdl sdlffcd_ffmpeg"
